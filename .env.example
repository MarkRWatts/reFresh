# Local Postgres via Homebrew (brew services start postgresql@16; createdb refresh_dev)
DATABASE_URL="postgresql://postgres@localhost:5432/refresh_dev?schema=public"

# Better Auth's session/cookie signing secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="change-me"

# Better Auth's own base URL — it does not infer this from the incoming
# request, so it must be set explicitly (see src/auth.ts's baseURL).
AUTH_URL="http://localhost:3000"

# Comma-separated allowlist of origins Better Auth's CSRF/origin-check
# middleware will accept requests from.
AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Resend API key (send-only scope is enough) — sends the six-digit sign-in
# code (src/lib/otp-email.ts) and household/app invites (src/lib/email.ts).
# The sending domain must be verified in Resend (DKIM/SPF/DMARC DNS
# records) or sends will fail.
RESEND_API_KEY="re_change-me"

# Optional: "Sign in with Pocket ID" (the home lab's OIDC provider, LAN/VPN
# only). Registered only when BOTH are set, so leave them unset to develop
# without it. The Pocket ID client needs the redirect URI
# http://localhost:3000/api/auth/callback/pocket-id for local dev; only
# members of the Pocket ID group `refresh` get in this way.
# POCKET_ID_CLIENT_ID="refresh"
# POCKET_ID_CLIENT_SECRET="change-me"

# Optional comma-separated, case-insensitive email allowlist (see
# src/lib/allowed-email.ts). Leave unset for local dev — empty/unset
# means the gate is OFF and anyone can sign in. Production sets this in
# .env.docker when going public; see DEPLOYMENT.md's "Going public" section.
# ALLOWED_EMAILS="you@example.com,partner@example.com"
