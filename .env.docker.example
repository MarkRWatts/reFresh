# Copy to `.env.docker` next to docker-compose.yml, then pass
# `--env-file .env.docker` to every `docker compose` invocation. Deliberately
# NOT named `.env` — that name is reserved for the dev-server config
# (DATABASE_URL for `npm run dev`) and would collide with it.

POSTGRES_USER=refresh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=refresh

# Multi-household auth (Better Auth) — see DEPLOYMENT.md for the Resend
# domain-verification setup the sign-in code email depends on.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=change-me
AUTH_URL=https://refresh.example.com
AUTH_TRUSTED_ORIGINS=https://refresh.example.com
RESEND_API_KEY=re_change-me

# Optional "Sign in with Pocket ID" (home network only). Registered only
# when both are set; empty = no Pocket ID button. Redirect URI on the Pocket
# ID client: <AUTH_URL>/api/auth/callback/pocket-id. Only members of the
# Pocket ID group `refresh` get in this way.
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

# Comma-separated, case-insensitive email allowlist — the app-level half of
# the belt-and-braces account gate (Cloudflare Access is the other half; see
# DEPLOYMENT.md's "Going public" section). Empty/unset = gate OFF (anyone
# can sign in) — fine while LAN-only, must be set before going public.
ALLOWED_EMAILS=owner@example.com,partner@example.com
