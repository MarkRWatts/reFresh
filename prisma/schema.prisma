// re:Fresh data model — see ../../reFresh-docs/project-plan.md for background.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth models (Better Auth) ---
//
// Native Better Auth field names/types throughout — no @map aliasing needed,
// since there's no pre-existing auth schema to stay column-compatible with
// (unlike a migration off some other auth library).

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  // Multi-tenancy (organization plugin, renamed — see auth.ts). A user
  // belongs to at most one household in practice (enforced in auth.ts's
  // organizationLimit + the accept-invite route), but the relation itself
  // is a list because that's the plugin's shape.
  members     Member[]
  invitations Invitation[] // invitations this user has sent, as inviter
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  scope                 String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added by the organization plugin (renamed from activeOrganizationId).
  // Tracks which household this session is "in" — a bare id column, not a
  // Prisma relation, matching how Better Auth itself manages it.
  activeHouseholdId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// --- Multi-tenancy (Better Auth organization plugin, renamed) ---
//
// Household/Member/Invitation are the plugin's Organization/Member/
// Invitation models, renamed via auth.ts's `schema.*.modelName`/`fields` to
// match this app's own domain language — shapes and endpoints are
// otherwise the plugin's own.

model Household {
  id        String   @id @default(cuid())
  name      String
  // Required by the plugin; not currently exposed anywhere in the UI.
  slug      String   @unique
  logo      String?
  metadata  String? // JSON-encoded; unused today
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]

  mealPlans      MealPlan[]
  recipeStates   HouseholdRecipeState[]
}

model Member {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // "owner" | "member" — see auth.ts's creatorRole
  createdAt   DateTime  @default(now())

  @@index([householdId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // A hint for the invite UI (e.g. "invited emma@..."), NOT an authorization
  // check — redemption is by token (the invitation's own id), same as
  // jinglejotter.com's equivalent design.
  email       String
  role        String?
  status      String    @default("pending") // pending | accepted | rejected | canceled
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  inviter     User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
}

// Per-household state on a recipe from the otherwise-shared catalog:
// favourite/hidden toggles and suggestion-cooldown tracking. Recipe itself
// stays global (no householdId of its own) since every household browses
// the same catalog — see project-plan.md Phase 16.
model HouseholdRecipeState {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipeId        String
  recipe          Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  isFavourite     Boolean   @default(false)
  isHidden        Boolean   @default(false)
  // Stamped whenever this recipe appears in any /suggest result for this
  // household (not just the one picked) — see markRecipesSuggested.
  lastSuggestedAt DateTime?

  @@unique([householdId, recipeId])
  @@index([recipeId])
  @@index([householdId, isFavourite])
  @@index([householdId, isHidden])
}

enum ProteinType {
  CHICKEN
  TURKEY
  BEEF
  LAMB
  PORK
  DUCK
  VENISON
  // Meat recipes that don't cleanly resolve to one of the species above
  // (rabbit, goat, quail, pheasant, wild boar, etc.) — classifyProteinType's
  // keyword heuristic, see proteinType.ts.
  MEAT_OTHER
  FISH
  VEGETARIAN
  VEGAN
  UNKNOWN
}

enum IngredientCategory {
  PRODUCE
  PROTEIN
  DAIRY
  PANTRY
  HERB_SPICE
  SAUCE_CONDIMENT
  GRAIN_STARCH
  OTHER
}

model Recipe {
  id             String      @id @default(cuid())
  hfId           String      @unique // id extracted from the HelloFresh URL slug
  slug           String      @unique
  name           String
  subtitle       String? // the "with ..." part of a HelloFresh recipe title
  description    String?
  imageUrl       String?
  // Null for a recipe imported from a scanned PDF card — there's no page it
  // came from. Always populated for scraped recipes, and inherited as
  // provenance (not a real source) by clones — see isUserCreated below.
  sourceUrl      String?
  cookMinutes    Int?
  servings       Int?
  calories       Int?
  // Per-serving nutrition from the JSON-LD's NutritionInformation block
  // (all grams). saltGrams maps from the schema.org field `sodiumContent`,
  // which HelloFresh actually populates with its own "Salt" label's value
  // in grams, not sodium-in-milligrams as the field name implies.
  fatGrams          Float?
  saturatedFatGrams Float?
  carbsGrams        Float?
  sugarGrams        Float?
  proteinGrams      Float?
  fiberGrams        Float?
  saltGrams         Float?
  proteinType    ProteinType @default(UNKNOWN)
  proteinTypeManualOverride Boolean @default(false)
  cuisine        String?
  category       String?
  // Ordered cooking steps as [{text, imageUrl, caption}], stored as JSON
  // since some recipes have a distinct photo + caption per step (e.g.
  // "Chip, Chip, Hooray") that a plain text array can't carry.
  steps          Json        @default("[]")
  ratingValue    Float?
  ratingCount    Int?
  // HelloFresh's own internal publish-status flags for this recipe,
  // extracted from an embedded app-data blob (not the SEO JSON-LD, which
  // doesn't carry these) — see appData.ts. False for draft/test/removed
  // recipes ("GAP £3.50" placeholders, "Andre Test Prawn Creamy Pasta")
  // that are still reachable via direct URL and still show up in the
  // public sitemap.
  isPublished    Boolean     @default(true)
  isActive       Boolean     @default(true)
  // False for scraped entries that aren't really a cookable recipe: zero
  // ingredients (legacy/empty stub pages), not published/active per above,
  // or an explicit "0 minutes" cook time combined with no real method
  // (serving-suggestion platters like a cheese board — HelloFresh
  // considers these legitimately published, just not something you cook).
  // Computed at scrape time — see upsertRecipe.ts — since Prisma can't
  // filter on array length directly. Excluded from the default browse view,
  // but not deleted: still reachable by slug, and recomputed on re-scrape.
  isBrowsable    Boolean     @default(true)
  // HelloFresh frequently remixes the same "hero" component (e.g. a fried
  // chicken burger) with different sides across separate weekly menus,
  // producing near-duplicate recipes under different ids/names. Computed
  // offline by scripts/detect-variants.ts (IDF-weighted ingredient-overlap
  // clustering — see src/lib/recipes/variantDetection.ts), not at scrape
  // time, since it's a whole-catalog comparison. Null if this recipe isn't
  // part of a detected variant cluster, or is the cluster's chosen
  // representative; otherwise points to that representative, which is what
  // the default browse view shows in its place.
  variantOfId    String?
  variantOf      Recipe?     @relation("RecipeVariants", fields: [variantOfId], references: [id])
  variants       Recipe[]    @relation("RecipeVariants")
  // True for a recipe created by cloning + editing an existing one (see
  // clonedFromId below), rather than scraped from HelloFresh. hfId/slug are
  // still populated (with a synthetic hfId) so it fits the same unique-key
  // shape as scraped recipes; sourceUrl is inherited from the clone origin
  // as an honest provenance record, not a page this recipe actually came
  // from. `npm run reprocess` never touches these rows — it only ever
  // upserts by hfId against cached scraped HTML.
  isUserCreated  Boolean     @default(false)
  // True for a recipe created by parsing a scanned HelloFresh card PDF
  // (see src/lib/pdfImport). A more specific provenance tag than
  // isUserCreated, which is also true for these rows so they pick up the
  // same "editable" treatment as clones (ingredient editor, etc.).
  isPdfImport    Boolean     @default(false)
  // The recipe this one was cloned from, if any. Deliberately a separate
  // field from variantOfId: that one is catalog-clustering machinery that
  // scripts/detect-variants.ts resets and recomputes wholesale on every
  // run, so reusing it here would silently erase clone provenance.
  clonedFromId   String?
  clonedFrom     Recipe?     @relation("RecipeClones", fields: [clonedFromId], references: [id])
  clones         Recipe[]    @relation("RecipeClones")
  lastScrapedAt  DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  ingredients      RecipeIngredient[]
  mealPlanRecipes  MealPlanRecipe[]
  householdStates  HouseholdRecipeState[]

  @@index([proteinType])
  @@index([cuisine])
  @@index([calories])
  @@index([cookMinutes])
  @@index([isBrowsable])
  @@index([variantOfId])
  @@index([clonedFromId])
}

model Ingredient {
  id            String             @id @default(cuid())
  canonicalName String             @unique
  category      IngredientCategory @default(OTHER)
  // The unit HelloFresh actually packages/ships this ingredient in, when
  // it isn't already a plain weight/volume — e.g. "pot(s)", "sachet(s)",
  // "carton(s)" (see the `unit` values landing in RecipeIngredient).
  // Paired with packagedUnitQuantity/packagedUnitBase below so the
  // shopping list can convert "1 pot" into a real, summable amount (see
  // sharedIngredients.ts). Filled in by manual research on the ingredient
  // review page — HelloFresh's scraped data never states real pack sizes.
  packagedUnit         String?
  // How many packagedUnitBase one packagedUnit equals — e.g. 150 for a
  // "pot(s)" of soured cream measured in "ml".
  packagedUnitQuantity Float?
  // The precise, scalable unit recipes get normalized to — usually "g" or
  // "ml", but can be any real measuring unit (e.g. "tbsp", "bunch") when
  // that's genuinely how the ingredient is used/measured (see
  // packagedUnitBaseGrams below for that case).
  packagedUnitBase     String?
  // Only set when packagedUnitBase isn't itself "g" or "ml": how many
  // grams equal one packagedUnitBase unit (e.g. 15 for honey's "tbsp", 10
  // for coriander's "bunch") — lets a recipe recorded in grams be
  // converted to the real measuring unit instead of relabeled as an
  // implausible tiny gram amount. Always a fact derived by a human
  // cross-referencing overlapping gram/base-unit data for THIS ingredient
  // (see getIngredientConversionReview's "gram-ratio-known" bucket) —
  // never inferred automatically, since a single ratio isn't guaranteed to
  // hold at every quantity scale (a spoon-measured ratio doesn't apply to
  // a baking-scale amount of the same ingredient).
  packagedUnitBaseGrams Float?
  // Free-text substitution guidance for a HelloFresh-proprietary
  // blend/product with no single real-world supermarket equivalent (e.g.
  // "Central American Style Spice Mix") — shown on the shopping list next
  // to the ingredient rather than powering any matching logic.
  shoppingListNote     String?

  aliases          IngredientAlias[]
  recipeIngredients RecipeIngredient[]
}

model IngredientAlias {
  id           String     @id @default(cuid())
  rawText      String     @unique
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
}

model RecipeIngredient {
  id           String     @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Float?
  unit         String?
  rawText      String

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
}

model MealPlan {
  id          String    @id @default(cuid())
  label       String
  createdAt   DateTime  @default(now())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  recipes MealPlanRecipe[]

  @@index([householdId])
}

model MealPlanRecipe {
  id         String   @id @default(cuid())
  mealPlanId String
  recipeId   String
  // Per-plan serving-count override. Null means "use the recipe's own base
  // servings" (i.e. no scaling) — this is the common case, so recipes are
  // added to a plan without needing to know their base servings up front.
  servings   Int?

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, recipeId])
}

// A PDF card that's been parsed (see src/lib/pdfImport) but not yet
// reviewed and committed into a real Recipe. OCR extraction is imperfect
// by design (see parseCardPdf.ts) — this is the staging area the review
// screen edits before a human confirms it. Its cover/step images live on
// disk under RECIPE_IMAGES_DIR/_drafts/<id>/ (see imageStorage.ts), not in
// this row, since Json isn't a sane place for binary blobs.
model PdfImportDraft {
  id               String   @id @default(cuid())
  originalFilename String
  templateId       String
  // DraftRecipeData (see parseCardPdf.ts) — a ParsedCardRecipe with its
  // image Buffers stripped out.
  data             Json
  createdAt        DateTime @default(now())
}
